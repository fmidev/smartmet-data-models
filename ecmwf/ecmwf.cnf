MODEL=ecmwf
MODEL_ID=240

# Default world modify crop to match a smaller domain if needed.
AREA=world

# To crop area to a smaller domain, example Finland.
#CROP=LEFT,BOTTOM,RIGHT,TOP
#CROP=19,59,32,71

# ---------------------------------------------------------------------------
# DATA SOURCE — uncomment one block and the matching UPDATE_SCRIPT line
# ---------------------------------------------------------------------------

# Local ECMWF dissemination (files arrive via other means, no update script)
MODEL_RAW_ROOT='/smartmet/data/incoming/ecmwf'
MODEL_RAW_DIR='/$RT_DATE_HHMMSS'
MODEL_RAW_SFC='\*.bin'
MODEL_RAW_PL='\*hPa\*.bin'
MODEL_RAW_MASK='\*.bin'
#UPDATE_SCRIPT=

# ECMWF open data via curl + jq (byte-range download of selected fields only).
# Sources are tried in order; AWS is preferred, data.ecmwf.int is used only
# when it has had the cycle for OPENDATA_FALLBACK_DELAY minutes and AWS not,
# or when downloads from AWS have kept failing (throttling) for that long.
# Requires: curl, jq
#MODEL_RAW_ROOT='/smartmet/data/incoming/ecmwf'
#MODEL_RAW_DIR=''
#MODEL_RAW_SFC='\*ifs_sfc\*${RT_DATE_MMDD}${RT_HOUR}\*.grib2'
#MODEL_RAW_PL='\*ifs_pl\*${RT_DATE_MMDD}${RT_HOUR}\*.grib2'
#MODEL_RAW_MASK='\*.grib2'
#UPDATE_SCRIPT=update-opendata.sh
#OPENDATA_SOURCES="aws ecmwf"          # aws, ecmwf or a mirror URL
#OPENDATA_RESOL=0p25                   # 0p1 or 0p25
#OPENDATA_CYCLES="00 06 12 18"         # 06/18 runs go to +144 h
#OPENDATA_STEPS="0:144:3,150:240:6"    # start:end:increment or list
#OPENDATA_SFC_PARAMS="2t,2d,msl,10u,10v,tp,tcc,mucape,ptype,sd,z"  # empty = no surface
#OPENDATA_PL_PARAMS="gh,t,r,u,v,w"     # empty = no pressure levels
#OPENDATA_PL_LEVELS="1000,925,850,700,600,500,400,300,250,200,150,100,50"
#OPENDATA_JOBS=2                       # steps downloaded in parallel
#OPENDATA_FALLBACK_DELAY=60            # minutes before using a later source
#OPENDATA_RETRIES=8                    # curl retries per request, waits double each time
#OPENDATA_MAX_RUNTIME=30               # minutes per run before leaving steps to next run;
                                      # steps already running finish after it

# ECMWF open data via AWS CLI (s3://ecmwf-forecasts)
# Requires: awscli
#MODEL_RAW_ROOT='/smartmet/data/incoming/ecmwf'
#MODEL_RAW_DIR=''
#MODEL_RAW_SFC='\*ifs_sfc\*${RT_DATE_MMDD}${RT_HOUR}\*.grib2'
#MODEL_RAW_PL='\*ifs_pl\*${RT_DATE_MMDD}${RT_HOUR}\*.grib2'
#MODEL_RAW_MASK='\*.grib2'
#UPDATE_SCRIPT=update-opendata-awscli.sh

# ECMWF open data via Python ecmwf-opendata client (parallel download)
# Requires: pip3 install --user ecmwf-opendata (as smartmet user)
#MODEL_RAW_ROOT='/smartmet/data/incoming/ecmwf'
#MODEL_RAW_DIR=''
#MODEL_RAW_SFC='\*ifs_sfc\*${RT_DATE_MMDD}${RT_HOUR}\*.grib2'
#MODEL_RAW_PL='\*ifs_pl\*${RT_DATE_MMDD}${RT_HOUR}\*.grib2'
